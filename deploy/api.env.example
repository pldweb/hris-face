# Copy to /etc/hris/api.env on the VPS, mode 600, owned by the hris user.
APP_ENV=production
LISTEN_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://hris:CHANGE_ME@127.0.0.1:5432/hris?sslmode=disable
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
FACE_SERVICE_URL=http://127.0.0.1:8000
# CIDR list, comma-separated -- docs/PRD.md section 7.4.
OFFICE_IP_ALLOWLIST=203.0.113.0/29
