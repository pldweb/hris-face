[Unit]
Description=HRIS Face Recognition Service
After=network.target

[Service]
Type=simple
User=hris
WorkingDirectory=/opt/hris/face
ExecStart=/opt/hris/face/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hris/face

[Install]
WantedBy=multi-user.target
